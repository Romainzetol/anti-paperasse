ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Requis si ta clé est liée à un compte avec plusieurs workspaces (voir erreur
# "anthropic-workspace-id is required..."). Trouve l'ID sur console.anthropic.com,
# dans les paramètres de l'organisation / workspace.
ANTHROPIC_WORKSPACE_ID=
PORT=3000

# Modèle Claude utilisé pour les 3 routes. Par défaut Haiku (le moins cher) :
# largement suffisant a priori pour ce niveau d'extraction, mais à valider sur de
# vrais documents avant de lancer en prod (voir README, section "Coûts"). Repasse
# sur un Sonnet ici si la précision ne suit pas, sans toucher au code.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Coupe-circuit temporaire : nombre max d'appels Claude (toutes routes confondues)
# par jour, tous utilisateurs confondus, avant que l'API ne renvoie une erreur 429.
# Juste un filet de sécurité en attendant de vrais quotas par utilisateur.
MAX_DAILY_CLAUDE_CALLS=200

# Secret partagé entre le backend et l'appli mobile (voir mobile/src/config.js).
# Bloque les appels directs à l'API par des personnes qui tomberaient sur l'URL du
# backend sans passer par l'appli. Ce n'est PAS une vraie authentification (le secret
# est embarqué dans le bundle de l'appli et reste extractible par une personne motivée)
# mais ça arrête les abus non ciblés. Génère une valeur aléatoire, ex :
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_SHARED_SECRET=
